{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "futsal-friday-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],

  "observability": {
    "enabled": true
  },

  // Hourly. Reminders are why: "three hours before kickoff" cannot be hit by a
  // once-a-day job. The handler is idempotent, and the session bookkeeping
  // inside it still only runs at 08:00 ICT. 8,760 invocations a year is noise
  // against the free tier's 100k requests/day.
  "triggers": {
    "crons": ["0 * * * *"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "futsal-friday",
      // Replace with the id printed by `wrangler d1 create futsal-friday`.
      "database_id": "3885f45d-6518-4693-8cc7-b97aeee866d7",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [
    {
      "binding": "PROOFS",
      "bucket_name": "futsal-friday-proofs"
    }
  ],

  "vars": {
    // Origin allowed to call this API with credentials. Set to your Pages URL
    // (or custom domain) before deploying. "*" is only sane for local dev.
    "WEB_ORIGIN": "https://futsal-friday.pages.dev",
    // Public URL of the app, embedded in the "copy summary" text.
    "APP_URL": "https://futsal-friday.pages.dev",
    // Cap on a single SSE stream before the server asks the client to
    // reconnect. Keeps connections (and their Redis keepalives) bounded.
    "SSE_MAX_DURATION_SECS": "600",
    // How long before kickoff the match reminder goes out.
    "REMINDER_LEAD_HOURS": "3"
  }

  // Secrets — set with `wrangler secret put <NAME>`, never in this file:
  //   GROUP_INVITE_CODE        shared code that gates the whole app
  //   AUTH_SECRET              HMAC key for identity tokens (32+ random bytes)
  //   UPSTASH_REDIS_REST_URL   from the Upstash console
  //   UPSTASH_REDIS_REST_TOKEN from the Upstash console
  //
  // Realtime degrades to polling if the Upstash pair is absent, so local dev
  // works without an Upstash account.
}
