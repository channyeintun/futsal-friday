# Copy to `.dev.vars` (gitignored) for local development.
# In production these are set with `wrangler secret put <NAME>`.

# There is no shared invite code any more — sign in with a claim link:
#   npm run claim:bootstrap -w @futsal/api -- mem_organizer --local

# HMAC key for identity tokens. Generate a real one for production:
#   openssl rand -base64 32
AUTH_SECRET=dev-only-secret-do-not-use-in-production

# Optional. Without these, realtime is disabled and the frontend polls every
# 30s instead — which is a perfectly usable way to develop.
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxx
