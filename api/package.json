{
  "name": "@futsal/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Futsal Friday REST API — Rust on Cloudflare Workers, D1 + R2 + Upstash.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check": "cargo check --target wasm32-unknown-unknown && npm test",
    "db:migrate:local": "wrangler d1 migrations apply futsal-friday --local",
    "db:migrate:remote": "wrangler d1 migrations apply futsal-friday --remote",
    "db:seed:local": "wrangler d1 execute futsal-friday --local --file=./seed.sql",
    "test": "cargo test -p futsal-core && cargo test -p futsal-api",
    "test:push": "cargo test -p futsal-api push",
    "push:keys": "node scripts/generate-vapid.mjs",
    "claim:bootstrap": "node scripts/bootstrap-link.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.40.0"
  }
}
