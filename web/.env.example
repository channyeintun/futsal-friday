# Copy to `.env.local` for local development, or set in the Cloudflare Pages
# dashboard for a deployment. Both are baked in at build time.

# Base URL of the Worker API. Leave unset in development: the Vite dev server
# proxies /api to http://localhost:8787, which keeps everything same-origin.
# VITE_API_URL=https://futsal-friday-api.<your-subdomain>.workers.dev

# Public URL of this app, used in the "copy summary" text so people who see the
# message in the group chat can find their way in.
# VITE_APP_URL=https://futsal-friday.pages.dev
