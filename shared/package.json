{
  "name": "@futsal/shared",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Types, zod schemas and pure helpers shared between the Worker API and the web frontend.",
  "exports": {
    ".": "./src/index.ts",
    "./events": "./src/events.ts",
    "./time": "./src/time.ts",
    "./money": "./src/money.ts"
  },
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "npm run test:logic && npm run test:i18n",
    "test:logic": "esbuild test/logic.test.ts --bundle --platform=node --format=esm --outfile=.logic-test.mjs --log-level=error && node .logic-test.mjs",
    "test:i18n": "esbuild test/i18n.test.ts --bundle --platform=node --format=esm --outfile=.i18n-test.mjs --log-level=error && node .i18n-test.mjs"
  },
  "dependencies": {
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.9.2"
  }
}
